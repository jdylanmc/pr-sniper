{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR Sniper",
  "version": "0.1.0",
  "identifier": "com.jdylanmc.pr-sniper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Human-owned pull request review, from your menu bar.",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
